{
  "name": "enview",
  "version": "0.2.0",
  "description": "Cross-project .env file scanner, auditor, and drift detector. Know what secrets live where — without exposing them.",
  "type": "module",
  "bin": {
    "enview": "./bin/enview.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./scanner": "./src/scanner.js",
    "./history": "./src/history.js",
    "./server": "./src/server.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "node bin/enview.js",
    "test": "node test/run.mjs",
    "ui": "node bin/enview.js ui",
    "protect": "node bin/enview.js protect"
  },
  "keywords": [
    "dotenv",
    "env",
    "secrets",
    "security",
    "audit",
    "cli",
    "dotenvx",
    "sops",
    "encryption",
    "ai-safety",
    "environment-variables",
    "secrets-management",
    "developer-tools"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0"
  },
  "author": "PickBits.AI",
  "homepage": "https://github.com/pickbitsai/enView#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pickbitsai/enView.git"
  },
  "bugs": {
    "url": "https://github.com/pickbitsai/enView/issues"
  }
}
